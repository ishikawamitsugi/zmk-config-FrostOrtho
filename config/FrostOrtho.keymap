#include <input/processors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

// AML クリックしたときにタイムアウトを延長

&mkp_input_listener { input-processors = <&zip_temp_layer 6 10000>; };

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 7>,
                <&macro_press>,
                <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>,
                <&macro_release>,
                <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>;

            label = "SCREENSHOT";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        // Kyemap Editor用

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };

        vol_up_down: vol_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            bindings = <&kp C_VOL_DN>, <&kp C_VOL_UP>;
        };

        // DYA Studio用

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_DN>;
            ccw-binding = <&kp C_VOL_UP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W  &kp E         &kp R     &kp T                            &kp Y        &kp U                        &kp I      &kp O       &kp P
&kp A      &kp S  &kp D         &kp F     &kp G                            &lt 5 H      &lt 7 J                      &kp K      &kp L       &kp SEMICOLON
&kp Z      &kp X  &kp C         &kp V     &kp B                            &kp N        &kp M                        &kp COMMA  &kp PERIOD  &kp SLASH
&kp LCTRL  &none  &kp LEFT_ALT  &kp LGUI  &lt 1 TAB  &mt LSHIFT SPACE      &lt 2 ENTER  &mt RIGHT_CONTROL BACKSPACE  &mo 3      &lt 4 F10   &kp ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>, <&rsr_trans>;
        };

        layer_1 {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &kp NUMBER_4    &kp N5              &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
&kp LEFT      &kp UP_ARROW  &kp DOWN        &kp RIGHT       &trans              &none   &none   &none   &none   &none
&trans        &trans        &kp LANGUAGE_2  &kp LANGUAGE_1  &trans              &trans  &trans  &trans  &none   &kp F12
&trans        &trans        &trans          &trans          &trans  &trans      &trans  &none   &trans  &trans  &kp ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>, <&rsr_trans>;
        };

        layer_2 {
            bindings = <
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)   &kp LS(N5)              &kp LS(NUMBER_6)  &kp LS(N7)      &kp LS(N8)        &kp LS(N9)         &kp LS(N0)
&none             &none             &kp GRAVE         &kp SQT            &none                   &kp EQUAL         &kp MINUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp NON_US_BACKSLASH
&none             &none             &kp TILDE         &kp DOUBLE_QUOTES  &none                   &kp PLUS          &kp UNDERSCORE  &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp PIPE
&none             &none             &trans            &trans             &trans      &trans      &trans            &trans          &trans            &none              &none
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            bindings = <
&none   &trans  &none   &trans  &trans              &trans  &trans                &trans          &trans  &trans
&none   &none   &none   &none   &none               &trans  &kp LC(LEFT)          &kp LC(RIGHT)   &trans  &trans
&none   &trans  &trans  &trans  &trans              &trans  &kp LS(LG(NUMBER_4))  &kp LS(LG(N5))  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                &trans          &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans              &trans          &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans              &studio_unlock  &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans        &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &trans  &mkp MB1   &mkp MB2   &mkp MB3   &trans
&trans  &trans  &trans  &trans  &trans              &trans  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans     &trans     &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_7 {
            bindings = <
&kp LC(Z)  &kp LC(Y)    &trans       &trans       &trans              &trans  &trans  &trans  &trans  &trans
&trans     &trans       &trans       &trans       &trans              &trans  &trans  &trans  &trans  &trans
&trans     &screenshot  &kp LC(INS)  &kp LS(INS)  &trans              &trans  &trans  &trans  &trans  &trans
&trans     &trans       &trans       &trans       &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
